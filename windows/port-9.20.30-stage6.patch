+isc_file_settime(const char *file, isc_time_t *when) {
+	REQUIRE(file != NULL && when != NULL);
+#ifdef _WIN32
+	struct __utimbuf64 times;
+	times.actime = times.modtime = (__time64_t)isc_time_seconds(when);
+	if (_utime64(file, &times) != 0) {
+		return isc__errno2result(errno);
+	}
+#else
+	struct timeval times[2];
+	times[0].tv_sec = times[1].tv_sec = (time_t)isc_time_seconds(when);
+	times[0].tv_usec = times[1].tv_usec =
+		(int32_t)(isc_time_nanoseconds(when) / 1000);
+	if (utimes(file, times) != 0) {
+		return isc__errno2result(errno);
+	}
+#endif
+	return ISC_R_SUCCESS;
+}
